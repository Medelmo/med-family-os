# Generate real secrets before deploying: openssl rand -base64 32

# POSTGRES_PASSWORD sets the password for the `medfamily` Postgres role
# (docker-compose.yml). The password segment of DATABASE_URL must match it
# exactly, or the app container will fail to connect to `db`.
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
DATABASE_URL=postgres://medfamily:change-me-to-a-strong-random-value@db:5432/medfamily

APP_URL=https://family.example.internal

# Auth.js session/JWT encryption secret (see ADR-006). Minimum 32 bytes.
AUTH_SECRET=replace-with-a-random-secret

# Read-only, narrowly scoped token for GET /api/ha/summary (see
# docs/integrations/home-assistant.md and ADR-018). Minimum 32 characters:
# a shorter one is refused, and leaving this unset disables the endpoint
# entirely rather than opening it. Generate with: openssl rand -base64 32
HA_READONLY_TOKEN=replace-with-a-scoped-secret-at-least-32-chars

# Set to false to stop this instance processing the outbox (ADR-013).
# OUTBOX_WORKER_ENABLED=false
# OUTBOX_POLL_INTERVAL_MS=10000
# REMINDER_SCAN_INTERVAL_MS=60000
